---
import { getDict, type Lang } from '../i18n/translations';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = getDict(lang).popup;

const message = t.message;
const tagline = t.tagline;
const typeSpeed = 55;
const autoDismiss = 3200;
---

<div class="toast" id="welcome-toast" role="status" aria-live="polite" hidden>
	<img class="logo" src="/WA_1789363446432.jpg" alt="" width="36" height="36" />
	<div class="text">
		<p class="title">
			<span class="typed-text"></span><span class="cursor"></span>
		</p>
		<p class="tagline">{tagline}</p>
	</div>
	<button class="close" type="button" aria-label="Dismiss">&times;</button>
</div>

<script define:vars={{ message, typeSpeed, autoDismiss }}>
	const toast = document.getElementById('welcome-toast');

	if (toast != null) {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (sessionStorage.getItem('egs-welcomed') === '1') {
			toast.remove();
		} else {
			sessionStorage.setItem('egs-welcomed', '1');

			const typed = toast.querySelector('.typed-text');
			const cursor = toast.querySelector('.cursor');
			const tagline = toast.querySelector('.tagline');
			const close = toast.querySelector('.close');

			const dismiss = () => {
				toast.classList.add('closing');
				setTimeout(() => toast.remove(), 300);
			};

			close?.addEventListener('click', dismiss);

			toast.hidden = false;
			requestAnimationFrame(() => toast.classList.add('shown'));

			if (reduced) {
				if (typed) typed.textContent = message;
				cursor?.remove();
				tagline?.classList.add('shown');
				setTimeout(dismiss, autoDismiss);
			} else {
				const type = (i = 0) => {
					if (typed == null) return;
					typed.textContent = message.slice(0, i);
					if (i < message.length) {
						setTimeout(() => type(i + 1), typeSpeed);
					} else {
						cursor?.remove();
						tagline?.classList.add('shown');
						setTimeout(dismiss, autoDismiss);
					}
				};

				setTimeout(() => type(0), 300);
			}
		}
	}
</script>

<style>
	.toast {
		position: fixed;
		top: 1rem;
		left: 50%;
		z-index: 1000;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		width: fit-content;
		max-width: calc(100vw - 2rem);
		padding: 0.55rem 0.7rem;
		background: var(--color-ink);
		border: 1px solid rgba(248, 241, 228, 0.12);
		border-radius: 6px;
		border-left: 3px solid var(--color-accent);
		transform: translate(-50%, -120%);
		opacity: 0;
		transition:
			transform 0.35s var(--ease-out-soft),
			opacity 0.35s var(--ease-out-soft),
			width 0.12s linear;
	}

	.toast.shown {
		transform: translate(-50%, 0);
		opacity: 1;
	}

	.toast.closing {
		transform: translate(-50%, -120%);
		opacity: 0;
	}

	.logo {
		flex: none;
		width: 34px;
		height: 34px;
		object-fit: cover;
		border-radius: 3px;
	}

	.text {
		flex: 1;
		min-width: 0;
	}

	.title {
		display: flex;
		align-items: center;
		margin: 0;
		font-family: var(--font-accent);
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--color-paper);
		white-space: nowrap;
	}

	.cursor {
		display: inline-block;
		width: 2px;
		height: 1rem;
		margin-left: 0.1em;
		background: var(--color-accent);
		animation: blink 0.9s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.tagline {
		margin: 0;
		max-height: 0;
		overflow: hidden;
		font-family: var(--font-accent);
		font-size: 0.75rem;
		color: var(--color-muted-on-dark);
		white-space: nowrap;
		opacity: 0;
		transform: translateY(-2px);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease,
			max-height 0.35s ease,
			margin-top 0.35s ease;
	}

	.tagline.shown {
		margin-top: 0.1rem;
		max-height: 1.2rem;
		opacity: 1;
		transform: translateY(0);
	}

	.close {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border: none;
		border-radius: 3px;
		background: transparent;
		font-size: 1.2rem;
		line-height: 1;
		color: var(--color-muted-on-dark);
		cursor: pointer;
		transition: background-color 0.2s, color 0.2s;
	}

	.close:hover {
		background: rgba(248, 241, 228, 0.1);
		color: var(--color-paper);
	}

	@media (prefers-reduced-motion: reduce) {
		.toast {
			transition: none;
		}

		.cursor {
			animation: none;
		}
	}
</style>
