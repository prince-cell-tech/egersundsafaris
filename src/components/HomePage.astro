---
import Layout from '../layouts/Layout.astro';
import WelcomePopup from './WelcomePopup.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import SafariTypes from './SafariTypes.astro';
import Packages from './Packages.astro';
import PricingGuide from './PricingGuide.astro';
import EnquiryForm from './EnquiryForm.astro';
import Footer from './Footer.astro';
import { getDict, type Lang } from '../i18n/translations';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = getDict(lang);
---

<Layout lang={lang}>
	<WelcomePopup lang={lang} />
	<Hero lang={lang} />
	<About lang={lang} />
	<SafariTypes lang={lang} />
	<Packages lang={lang} />
	<PricingGuide lang={lang} />

	<section class="contact" id="contact">
		<div class="intro" data-animate>
			<p class="eyebrow">{t.contact.eyebrow}</p>
			<h2>{t.contact.heading}</h2>
			<p>
				{t.contact.paragraph}
			</p>
		</div>

		<div data-animate style="--anim-delay: 0.1s">
			<EnquiryForm lang={lang} />
		</div>
	</section>

	<Footer lang={lang} />
</Layout>

<style>
	.contact {
		background: rgba(255, 77, 28, 0.92);
		color: var(--color-ink);
		text-align: center;
		padding: 5.5rem 1.5rem;
	}

	.contact h2 {
		font-size: clamp(2.1rem, 5vw, 3.1rem);
		color: var(--color-ink);
		margin: 0.5rem 0 1rem;
	}

	.contact p {
		color: var(--color-ink-soft);
		max-width: 480px;
		margin: 0 auto 1.8rem;
	}

	.contact .eyebrow {
		color: var(--color-ink);
	}

	.contact .intro {
		margin-bottom: 2.5rem;
	}
</style>
