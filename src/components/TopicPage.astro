---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import EnquiryForm from './EnquiryForm.astro';
import { packages } from '../data/packages';
import type { Topic } from '../data/topics';

interface Props {
	topic: Topic;
}

const { topic } = Astro.props;

const featured = topic.packageTitles
	.map((title) => packages.find((pkg) => pkg.title === title))
	.filter((pkg): pkg is NonNullable<typeof pkg> => Boolean(pkg));
---

<Layout
	lang="en"
	slug={topic.slug}
	title={topic.seo.title}
	description={topic.seo.description}
	ogImage={topic.ogImage}
	standalone
>
	<main>
		{/* Hero */}
		<section class="hero">
			<img src={topic.hero.image} alt={topic.hero.alt} width="1600" height="1000" fetchpriority="high" />
			<div class="hero-inner">
				<p class="eyebrow">{topic.hero.eyebrow}</p>
				<h1>{topic.hero.heading}</h1>
				<p class="lede">{topic.hero.lede}</p>
				<div class="actions">
					<a href="#contact" class="btn btn-primary">{topic.cta.eyebrow}</a>
					<a href="/" class="btn btn-secondary">All Safaris</a>
				</div>
			</div>
		</section>

		{/* Intro */}
		<section class="intro">
			<div class="intro-copy" data-animate>
				<p class="eyebrow">{topic.intro.eyebrow}</p>
				<h2>{topic.intro.heading}</h2>
				{topic.intro.paragraphs.map((para) => <p>{para}</p>)}
			</div>
			<figure data-animate style="--anim-delay: 0.1s">
				<img src={topic.intro.image} alt={topic.intro.imageAlt} loading="lazy" width="600" height="700" />
			</figure>
		</section>

		{/* Highlights */}
		<section class="highlights">
			<p class="eyebrow" data-animate>{topic.highlightsEyebrow}</p>
			<h2 data-animate style="--anim-delay: 0.1s">{topic.highlightsHeading}</h2>
			<div class="grid">
				{
					topic.highlights.map((item, i) => (
						<div class="card" data-animate style={`--anim-delay: ${0.1 + i * 0.08}s`}>
							<h3>{item.title}</h3>
							<p>{item.desc}</p>
						</div>
					))
				}
			</div>
		</section>

		{/* Itinerary */}
		<section class="itinerary">
			<div class="section-head" data-animate>
				<p class="eyebrow">{topic.itinerary.eyebrow}</p>
				<h2>{topic.itinerary.heading}</h2>
				<p class="subtext">{topic.itinerary.subtext}</p>
			</div>
			<ol class="days">
				{
					topic.itinerary.days.map((day, i) => (
						<li data-animate style={`--anim-delay: ${0.05 + i * 0.06}s`}>
							<span class="day-label">{day.label}</span>
							<div>
								<h3>{day.title}</h3>
								<p>{day.desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		{/* Matching packages */}
		<section class="pkg">
			<p class="eyebrow" data-animate>{topic.packagesEyebrow}</p>
			<h2 data-animate style="--anim-delay: 0.1s">{topic.packagesHeading}</h2>
			<div class="pkg-grid">
				{
					featured.map((pkg, i) => (
						<article class="pkg-card" data-animate style={`--anim-delay: ${0.1 + i * 0.1}s`}>
							<div class="thumb">
								<img src={pkg.image} alt={pkg.alt} loading="lazy" width="600" height="400" />
								{pkg.days && <span class="days-badge">{pkg.days}</span>}
							</div>
							<div class="pkg-body">
								<h3>{pkg.title}</h3>
								<div class="row">
									<span class="price">{pkg.price}</span>
									<a href="#contact" class="book">Book Now</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>

		{/* FAQ */}
		<section class="faq">
			<div class="section-head" data-animate>
				<p class="eyebrow">{topic.faq.eyebrow}</p>
				<h2>{topic.faq.heading}</h2>
			</div>
			<div class="faq-list">
				{
					topic.faq.items.map((item) => (
						<details>
							<summary>{item.q}</summary>
							<p>{item.a}</p>
						</details>
					))
				}
			</div>
		</section>

		{/* Enquiry */}
		<section class="contact" id="contact">
			<div class="intro-block" data-animate>
				<p class="eyebrow">{topic.cta.eyebrow}</p>
				<h2>{topic.cta.heading}</h2>
				<p>{topic.cta.text}</p>
			</div>

			<div data-animate style="--anim-delay: 0.1s">
				<EnquiryForm lang="en" />
			</div>
		</section>
	</main>

	<Footer lang="en" />
</Layout>

<style>
	@import '../styles/animations.css';

	.hero {
		position: relative;
		min-height: 78vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-ink);
	}

	.hero > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.55;
	}

	.hero-inner {
		position: relative;
		max-width: 1160px;
		width: 100%;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
		color: var(--color-paper);
	}

	.hero-inner .eyebrow {
		color: var(--color-accent);
	}

	.hero-inner h1 {
		font-size: clamp(2.4rem, 6vw, 4.2rem);
		color: var(--color-paper);
		margin: 0.4rem 0 1rem;
		max-width: 14ch;
	}

	.lede {
		max-width: 620px;
		font-size: 1.1rem;
		color: var(--color-muted-on-dark);
		margin: 0 0 2rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
	}

	.hero .btn-secondary {
		border-color: var(--color-paper);
		color: var(--color-paper);
	}

	.hero .btn-secondary:hover {
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.intro {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 3rem;
		align-items: center;
		max-width: 1060px;
		margin: 0 auto;
		padding: 5.5rem 1.5rem;
	}

	.intro h2 {
		font-size: clamp(1.9rem, 4vw, 2.7rem);
		margin: 0.4rem 0 1.2rem;
	}

	.intro p {
		color: var(--color-muted);
		margin: 0 0 1rem;
	}

	.intro figure {
		margin: 0;
	}

	.intro figure img {
		width: 100%;
		height: auto;
		border-radius: 4px;
		border: 1px solid var(--color-paper-dim);
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.highlights {
		max-width: 1160px;
		margin: 0 auto;
		padding: 5rem 1.5rem;
		text-align: center;
	}

	.highlights h2,
	.pkg h2 {
		font-size: clamp(1.9rem, 4.2vw, 2.7rem);
		margin: 0.4rem 0 2.4rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
		gap: 1.6rem;
		text-align: left;
	}

	.card {
		background: var(--color-paper);
		border: 1px solid var(--color-paper-dim);
		border-top: 3px solid var(--color-accent);
		border-radius: 4px;
		padding: 1.6rem;
	}

	.card h3 {
		font-size: 1.1rem;
		margin: 0 0 0.5rem;
	}

	.card p {
		color: var(--color-muted);
		font-size: 0.95rem;
		margin: 0;
	}

	.itinerary {
		background: rgba(18, 18, 18, 0.94);
		padding: 5.5rem 1.5rem;
	}

	.section-head {
		max-width: 720px;
		margin: 0 auto 3rem;
		text-align: center;
	}

	.itinerary h2 {
		color: var(--color-paper);
		font-size: clamp(1.9rem, 4vw, 2.7rem);
		margin: 0.4rem 0 0.8rem;
	}

	.itinerary .subtext {
		color: var(--color-muted-on-dark);
		margin: 0;
	}

	.days {
		list-style: none;
		max-width: 760px;
		margin: 0 auto;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.days li {
		display: flex;
		gap: 1.5rem;
		padding: 1.4rem 0;
		border-bottom: 1px solid rgba(248, 241, 228, 0.12);
	}

	.days li:first-child {
		border-top: 1px solid rgba(248, 241, 228, 0.12);
	}

	.day-label {
		flex: 0 0 5.5rem;
		font-family: var(--font-accent);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		padding-top: 0.2rem;
	}

	.days h3 {
		color: var(--color-paper);
		font-size: 1.15rem;
		margin: 0 0 0.35rem;
	}

	.days p {
		color: var(--color-muted-on-dark);
		margin: 0;
		font-size: 0.95rem;
	}

	.pkg {
		max-width: 1060px;
		margin: 0 auto;
		padding: 5rem 1.5rem;
		text-align: center;
	}

	.pkg-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 1.8rem;
		text-align: left;
	}

	.pkg-card {
		background: var(--color-paper);
		border: 1px solid var(--color-paper-dim);
		border-radius: 4px;
		overflow: hidden;
	}

	.thumb {
		position: relative;
		aspect-ratio: 3 / 2;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.days-badge {
		position: absolute;
		bottom: 0.75rem;
		left: 0.75rem;
		background: var(--color-ink);
		color: var(--color-paper);
		font-family: var(--font-accent);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.3rem 0.7rem;
		border-radius: 3px;
	}

	.pkg-body {
		padding: 1.3rem 1.4rem 1.5rem;
	}

	.pkg-body h3 {
		font-size: 1.15rem;
		margin: 0 0 1rem;
	}

	.pkg-body .row {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.price {
		font-family: var(--font-accent);
		font-weight: 700;
		font-size: 1.05rem;
	}

	.book {
		font-family: var(--font-accent);
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--color-paper);
		background: var(--color-ink);
		padding: 0.5rem 1.1rem;
		border-radius: 3px;
		text-decoration: none;
		transition: background-color var(--transition-base);
	}

	.book:hover {
		background: var(--color-accent);
		color: var(--color-ink);
	}

	.faq {
		max-width: 820px;
		margin: 0 auto;
		padding: 5rem 1.5rem;
	}

	.faq h2 {
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		margin: 0.4rem 0 0;
	}

	.faq-list {
		margin-top: 2.2rem;
	}

	.faq details {
		border-bottom: 1px solid var(--color-paper-dim);
		padding: 1.1rem 0;
	}

	.faq summary {
		cursor: pointer;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.05rem;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq summary::after {
		content: '+';
		font-size: 1.4rem;
		color: var(--color-accent);
		line-height: 1;
	}

	.faq details[open] summary::after {
		content: '−';
	}

	.faq details p {
		color: var(--color-muted);
		margin: 0.8rem 0 0;
		font-size: 0.96rem;
	}

	.contact {
		background: rgba(255, 77, 28, 0.92);
		color: var(--color-ink);
		text-align: center;
		padding: 5.5rem 1.5rem;
	}

	.contact h2 {
		font-size: clamp(2.1rem, 5vw, 3.1rem);
		color: var(--color-ink);
		margin: 0.5rem 0 1rem;
	}

	.contact p {
		color: var(--color-ink-soft);
		max-width: 560px;
		margin: 0 auto 1.8rem;
	}

	.contact .eyebrow {
		color: var(--color-ink);
	}

	.contact .intro-block {
		margin-bottom: 2.5rem;
	}
</style>
