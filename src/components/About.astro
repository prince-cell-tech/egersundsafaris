---
import { getDict, type Lang } from '../i18n/translations';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = getDict(lang).about;

const beyondAlts = [''];
---

<section class="about" id="about">
	<div class="inner">
		<p class="eyebrow" data-animate>{t.eyebrow}</p>
		<h2 data-animate style="--anim-delay: 0.1s">
			{t.heading}
		</h2>
		<p class="lede" data-animate style="--anim-delay: 0.15s">
			{t.intro1}
		</p>
		<p class="lede" data-animate style="--anim-delay: 0.2s">
			{t.intro2}
		</p>
		<p class="badge" data-animate style="--anim-delay: 0.25s">{t.badge}</p>

		<div class="features">
			{
				t.features.map((f, i) => (
					<div data-animate style={`--anim-delay: ${0.3 + i * 0.1}s`}>
						<h3>{f.title}</h3>
						<p>{f.desc}</p>
					</div>
				))
			}
		</div>
	</div>

	<div class="beyond">
		<p class="eyebrow" data-animate>{t.beyondEyebrow}</p>
		<div class="beyond-grid">
			{
				t.beyond.map((b, i) => (
					<div data-animate style={`--anim-delay: ${0.1 + i * 0.1}s`}>
						<div class="beyond-body">
							<h3>{b.title}</h3>
							<p>{b.desc}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>

	<div class="who-we-are">
		<div class="inner">
			<p class="eyebrow" data-animate>{t.whoEyebrow}</p>
			<p class="lede" data-animate style="--anim-delay: 0.1s">
				{t.whoText}
			</p>
		</div>
	</div>

	<div class="director">
		<blockquote data-animate>
			<p>{t.directorP1}</p>
			<p>{t.directorP2}</p>
			<p>{t.directorP3}</p>
			<cite>{t.directorCite}</cite>
		</blockquote>
	</div>
</section>

<style>
	.about {
		background: var(--color-paper);
	}

	.inner {
		max-width: 820px;
		margin: 0 auto;
		text-align: center;
		padding: 6rem 1.5rem 0;
	}

	h2 {
		font-size: clamp(2rem, 4.5vw, 2.9rem);
		color: var(--color-ink);
		margin: 0.4rem 0 1.2rem;
	}

	.lede {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--color-muted);
		max-width: 680px;
		margin: 0 auto 1.2rem;
	}

	.badge {
		display: inline-block;
		font-family: var(--font-accent);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent-dark);
		border: 1px solid var(--color-accent);
		padding: 0.35rem 1rem;
		margin: 0.4rem 0 0;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
		gap: 1px;
		background: var(--color-paper-dim);
		border: 1px solid var(--color-paper-dim);
		margin-top: 3rem;
		text-align: left;
	}

	.features > div {
		background: var(--color-paper);
		padding: 1.6rem 1.5rem;
	}

	.features h3 {
		font-size: 1rem;
		margin: 0 0 0.5rem;
		color: var(--color-ink);
	}

	.features p {
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--color-muted);
		margin: 0;
	}

	.beyond {
		padding: 5rem 1.5rem 0;
		max-width: 980px;
		margin: 0 auto;
		text-align: center;
	}

	.beyond-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
		gap: 1.25rem;
		margin-top: 2rem;
		text-align: left;
	}

	.beyond-grid > div {
		border: 1px solid var(--color-paper-dim);
		border-top: 3px solid var(--color-accent);
	}

	.beyond-body {
		padding: 1.8rem;
	}

	.beyond-grid h3 {
		font-size: 1.15rem;
		margin: 0 0 0.6rem;
		color: var(--color-ink);
	}

	.beyond-grid p {
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--color-muted);
		margin: 0;
	}

	.who-we-are {
		background: rgba(18, 18, 18, 0.92);
		margin-top: 5rem;
	}

	.who-we-are .inner {
		padding: 5rem 1.5rem;
	}

	.who-we-are .lede {
		color: var(--color-muted-on-dark);
	}

	.who-we-are .eyebrow {
		color: var(--color-accent);
	}

	.director {
		padding: 5rem 1.5rem 6rem;
		max-width: 720px;
		margin: 0 auto;
	}

	.director blockquote {
		margin: 0;
		padding-left: 1.4rem;
		border-left: 3px solid var(--color-accent);
	}

	.director p {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--color-ink-soft);
		margin: 0 0 1.1rem;
	}

	.director cite {
		display: block;
		font-family: var(--font-accent);
		font-style: normal;
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		color: var(--color-ink);
	}
</style>
