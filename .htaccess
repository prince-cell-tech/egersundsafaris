# Non-www -> www
RewriteCond %{HTTP_HOST} ^egersundtanzaniasafaris\.com$ [NC]
RewriteRule ^(.*)$ https://www.egersundtanzaniasafaris.com/$1 [R=301,L]

# Hostinger (LiteSpeed): website lives in dist/, index.php serves anything
# mod_rewrite misses. ErrorDocument makes /no/, /sv/, /de/ etc. work even if
# mod_rewrite is not available.
RewriteEngine On
RewriteRule ^_astro/(.*)$ dist/_astro/$1 [L]
RewriteRule ^images/(.*)$ dist/images/$1 [L]
RewriteRule ^videos/(.*)$ dist/videos/$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
ErrorDocument 404 /index.php

# --- Compression (LiteSpeed honours mod_deflate) ---
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
	AddOutputFilterByType DEFLATE application/javascript application/json
	AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
	ExpiresActive On
	# Hashed Astro assets: cache hard
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	# Images and fonts: cache long
	ExpiresByType image/jpeg "access plus 6 months"
	ExpiresByType image/png "access plus 6 months"
	ExpiresByType image/gif "access plus 6 months"
	ExpiresByType image/webp "access plus 6 months"
	ExpiresByType image/avif "access plus 6 months"
	ExpiresByType image/svg+xml "access plus 6 months"
	ExpiresByType video/mp4 "access plus 1 month"
	ExpiresByType video/webm "access plus 1 month"
	ExpiresByType font/woff2 "access plus 1 year"
	# HTML: always revalidate so deploys go live immediately
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
	# CSS/JS are content-hashed by Astro, so long immutable caching is safe
	<FilesMatch "\.(css|js|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	# Images keep stable filenames and can be replaced, so no "immutable"
	<FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|mp4|webm)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>
